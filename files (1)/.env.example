# Supabase — project settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# XRPL
XRPL_NETWORK=wss://xrplcluster.com

# Project wallet — pays out $RPLTS automatically. This wallet is ALSO the
# $RPLTS issuer (merged setup), so it can send freely without needing its
# own trustline or pre-funded balance.
# Use ONE of the two lines below — mnemonic is preferred if you have it.
PROJECT_WALLET_MNEMONIC=word1 word2 word3 ... word12
# PROJECT_WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECT_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# $RPLTS token — same address as PROJECT_WALLET_ADDRESS above.
RPLTS_ISSUER_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RPLTS_CURRENCY_CODE=RPLTS

# The wallet that minted the Ripplets NFT collection — used to filter
# "which NFTs count" everywhere in the app. Leave blank pre-launch; nothing
# will be discoverable until this is set.
RIPPLETS_NFT_ISSUER=

# Minimum accrued $RPLTS before the payout cycle bothers sending it —
# avoids paying tiny fractions and burning fees on nothing.
MIN_PAYOUT_THRESHOLD=1

PORT=3000

# TESTING ONLY — makes rewards accrue per-minute instead of per-day.
# MUST be false (or removed) before real launch.
REWARD_TEST_MODE=true
REWARD_TEST_RATE_PER_MIN=0.1
