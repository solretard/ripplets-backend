# Supabase — project settings > API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Xaman (Xumm) — apps.xumm.dev, create a new app
XUMM_API_KEY=your-xumm-api-key
XUMM_API_SECRET=your-xumm-api-secret

# XRPL
XRPL_NETWORK=wss://xrplcluster.com

# Project/escrow wallet — this wallet holds staked NFTs and pays out $RPLTS.
# Fund it with a small amount of XRP for reserves + transaction fees.
# NEVER commit the real seed to git.
PROJECT_WALLET_SEED=sXXXXXXXXXXXXXXXXXXXXXXXXXXX
PROJECT_WALLET_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# $RPLTS token
RPLTS_ISSUER_ADDRESS=rXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RPLTS_CURRENCY_CODE=RPLTS

PORT=3000

